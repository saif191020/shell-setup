#!/usr/bin/env bash
# Preview for fzf completion menus: list directories, show the top of files,
# print nothing for anything else (commands, options, hosts...).
# Takes the raw fzf line; fzf-tab-completion separates fields with \x01.
entry=${1%%$'\x01'*}
entry=${entry//\\/}                         # undo shell escaping (my\ dir -> my dir)
case "$entry" in "~"|"~/"*) entry="$HOME${entry#\~}" ;; esac
[ -e "$entry" ] || exit 0

if [ -d "$entry" ]; then
    if command -v eza >/dev/null 2>&1; then
        eza -1 --icons --group-directories-first --color=always "$entry"
    elif command -v exa >/dev/null 2>&1; then
        exa -1 --icons --group-directories-first --color=always "$entry"
    else
        ls -1 --color=always "$entry"
    fi
elif command -v bat >/dev/null 2>&1; then
    bat --style=numbers --color=always --line-range=:200 "$entry"
elif command -v batcat >/dev/null 2>&1; then
    batcat --style=numbers --color=always --line-range=:200 "$entry"
else
    head -n 200 "$entry"
fi
