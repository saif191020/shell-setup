# Safe, identity-free git defaults. install.sh adds this file to your global
# config with `include.path`; your own ~/.gitconfig (name, email, signing key)
# stays untouched and takes precedence where it sets the same key.

[init]
	defaultBranch = main
[core]
	pager = less -FRX
[push]
	autoSetupRemote = true
	followTags = true
[pull]
	ff = only
[fetch]
	prune = true
[rebase]
	autoStash = true
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
	algorithm = histogram
[rerere]
	enabled = true
[help]
	autocorrect = prompt
[alias]
	lg = log --graph --abbrev-commit --decorate --date=relative --format='%C(bold blue)%h%C(reset) %C(green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
	st = status -sb
	last = log -1 --stat
	undo = reset --soft HEAD~1
	unstage = restore --staged
	amend = commit --amend --no-edit
	branches = branch -vv --sort=-committerdate
